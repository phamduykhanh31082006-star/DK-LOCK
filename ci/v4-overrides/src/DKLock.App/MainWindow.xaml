<Window x:Class="DKLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DKLock.App.ViewModels"
        Title="DK LOCK" Width="1180" Height="780" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="dashboard"/>
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="applications"/>
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="folders"/>
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="vault"/>
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="accounts"/>
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="activity"/>
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="settings"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,22">
                        <Border Width="34" Height="34" Background="{StaticResource Brush.Accent}" CornerRadius="10">
                            <TextBlock Text="DK" Foreground="#09111F" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="DK LOCK" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Personal security" Style="{StaticResource SecondaryText}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Navigation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Shortcut}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="V4 PROTECTION CAPABILITIES" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="Application enforcement and encrypted local content protection require the DK LOCK core service to be online." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Background="#182C46" BorderBrush="#294F7B" BorderThickness="1" CornerRadius="10" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EngineStatusLabel}" FontSize="12" Foreground="{StaticResource Brush.Accent}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentPage}" Margin="30"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
