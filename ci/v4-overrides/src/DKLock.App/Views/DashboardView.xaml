<UserControl x:Class="DKLock.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Security overview" Style="{StaticResource TitleText}"/>
        <TextBlock Text="V4 extends the V3 application-protection core with encrypted local folder protection and Secure Documents while preserving the same service, IPC, state and authentication boundaries." Style="{StaticResource SecondaryText}" Margin="0,6,0,24"/>
        <Border Style="{StaticResource CardBorder}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="#182C46" CornerRadius="12">
                    <TextBlock Text="A" Foreground="{StaticResource Brush.Accent}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding EngineHeadline}" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="{Binding EngineDetail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <UniformGrid Columns="3" Margin="0,18,0,0">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Applications" Style="{StaticResource SecondaryText}"/><TextBlock Text="Available" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="V3 user-mode enforcement" Foreground="{StaticResource Brush.Success}" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="5,0">
                <StackPanel><TextBlock Text="Folders" Style="{StaticResource SecondaryText}"/><TextBlock Text="Available" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="V4 encrypted at rest" Foreground="{StaticResource Brush.Success}" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                <StackPanel><TextBlock Text="Vault" Style="{StaticResource SecondaryText}"/><TextBlock Text="Available" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="V4 Secure Documents" Foreground="{StaticResource Brush.Success}" Margin="0,6,0,0"/></StackPanel>
            </Border>
        </UniformGrid>
        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
            <Grid>
                <StackPanel><TextBlock Text="Quick Lock" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Quick Lock remains reserved for V6. V4 provides scoped application and folder unlock sessions without claiming the V6 global lock workflow." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel>
                <Button Content="LOCK NOW" Style="{StaticResource PrimaryButton}" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Available in V6"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
