<Window x:Class="DKLock.App.Dialogs.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK LOCK — Authentication" Width="500" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource DialogWindow}" Topmost="True">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleTextBlock" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,8,0,18" Style="{StaticResource SecondaryText}"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Credential" Margin="0,0,0,6"/>
            <ComboBox x:Name="CredentialBox" Height="38" SelectedIndex="0" Style="{StaticResource SecureComboBox}">
                <ComboBoxItem Tag="MasterPassword" Style="{StaticResource SecureComboBoxItem}"><TextBlock Text="Master password" Foreground="#111827"/></ComboBoxItem>
                <ComboBoxItem x:Name="PinItem" Tag="Pin" Style="{StaticResource SecureComboBoxItem}"><TextBlock Text="PIN" Foreground="#111827"/></ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Password or PIN" Margin="0,0,0,6"/>
            <PasswordBox x:Name="SecretBox" Height="38" Style="{StaticResource SecurePasswordBox}"/>
        </StackPanel>
        <StackPanel x:Name="ScopePanel" Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Unlock scope" Margin="0,0,0,6"/>
            <ComboBox x:Name="ScopeBox" Height="38" SelectedIndex="1" Style="{StaticResource SecureComboBox}">
                <ComboBoxItem Tag="Once" Style="{StaticResource SecureComboBoxItem}"><TextBlock Text="Once / manual relock" Foreground="#111827"/></ComboBoxItem>
                <ComboBoxItem Tag="FiveMinutes" Style="{StaticResource SecureComboBoxItem}"><TextBlock Text="5 minutes" Foreground="#111827"/></ComboBoxItem>
                <ComboBoxItem Tag="FifteenMinutes" Style="{StaticResource SecureComboBoxItem}"><TextBlock Text="15 minutes" Foreground="#111827"/></ComboBoxItem>
                <ComboBoxItem Tag="UntilServiceRestart" Style="{StaticResource SecureComboBoxItem}"><TextBlock Text="Until DK LOCK service restarts" Foreground="#111827"/></ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Continue" Style="{StaticResource PrimaryButton}" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
